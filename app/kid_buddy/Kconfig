config KID_BUDDY_APP
	bool "Kid Buddy - AI Role-Playing Companion"
	default n
	depends on GRAPHICS_LVGL
	depends on LV_USE_NUTTX
	depends on EXAMPLES_AI_AGENT_VELA
	---help---
		AI-powered children's companion with multi-role
		play system.  Supports 4 characters (Teacher,
		Storyteller, Scientist, Friend) with distinct
		personalities, voice styles, and LCD avatars.

if KID_BUDDY_APP

config KID_BUDDY_APP_PROGNAME
	string "Program name"
	default "kid_buddy"

config KID_BUDDY_APP_PRIORITY
	int "Kid Buddy task priority"
	default 100

config KID_BUDDY_APP_STACKSIZE
	int "Kid Buddy stack size"
	default 40960

config KID_BUDDY_APP_DATA_DIR
	string "Data directory"
	default "/data/kid_buddy"

endif
